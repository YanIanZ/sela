# Build context for the Go image (run from the repo root).
# Patterns need the **/ prefix to apply inside nested directories.
**/node_modules
**/.next
**/out
**/dist
**/*.tsbuildinfo
.git
.gitattributes
.vercel
.idea
.vscode
**/.DS_Store
**/*.log

# Never copy secrets into the image; pass them with --env-file at run time.
**/.env
**/.env.*
!.env.example

# Not needed to build or serve the app.
docs
tests
scripts
README.md

# Design decisions and review captures are development-only.
**/.impeccable
