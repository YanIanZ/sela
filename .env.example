# Sela environment template (Go runtime + React web).
# Copy the values you need into a git-ignored file such as .env.local or
# .env.docker-testing. Never commit real secrets.

# --- Runtime ---------------------------------------------------------------
SELA_ENV=development
SELA_ADDR=:8080
SELA_WEB_DIR=web/dist
SELA_PUBLIC_ORIGIN=http://localhost:8080
SELA_SECURE_COOKIES=false
SELA_TRUST_PROXY=false
SELA_METRICS_TOKEN=
# Optional public Redis cache/control plane (redis:// or rediss://).
# Unset keeps Sela fully functional without Redis.
SELA_REDIS_URL=
SELA_RESEARCH_KB=data/research/corpus/knowledge_base.jsonl

# --- PostgreSQL 16 and encryption -----------------------------------------
SELA_DATABASE_URL=postgres://sela:sela-dev-only@127.0.0.1:5432/sela?sslmode=disable
SELA_DB_AUTO_MIGRATE=true
SELA_DB_MAX_CONNS=10
SELA_DB_STATEMENT_TIMEOUT=30s
# Generate with: go run ./cmd/sela keys generate-kek --env development
SELA_DATA_KEK=
SELA_DATA_KEK_ID=
# id:base64,... keys being retired
SELA_DATA_KEK_PREVIOUS=

# --- Guest and session policy ---------------------------------------------
SELA_GUEST_INACTIVE_TTL=168h
SELA_GUEST_MAX_AGE=720h
SELA_MAX_GUEST_ACCOUNTS=10000
SELA_ALLOWED_AGE_BANDS=18_plus
SELA_GUARDIAN_CONSENT_REQUIRED=true
SELA_DATA_REGION_LABEL=

# --- Accounts and hashing --------------------------------------------------
SELA_ARGON2_MEMORY_KIB=65536
SELA_ARGON2_ITERATIONS=2
SELA_ARGON2_PARALLELISM=1
SELA_AUTH_HASH_CONCURRENCY=2
SELA_SESSION_IDLE=2h
SELA_SESSION_ABSOLUTE=12h
SELA_SESSION_TRUSTED_IDLE=168h
SELA_SESSION_TRUSTED_ABSOLUTE=720h
SELA_REAUTH_WINDOW=10m

# --- Meta model ------------------------------------------------------------
# disabled | modal (self-hosted vLLM on Modal) |
# meta_api (Meta Model API; development, test and demo only) | test_double
SELA_LLM_MODE=disabled
SELA_LLM_BASE_URL=
SELA_LLM_API_KEY=
SELA_MODAL_KEY=
SELA_MODAL_SECRET=
SELA_LLM_SERVED_MODEL=sela-glimmer-cec94fc
SELA_LLM_MODEL_ID=meta-models/Muse-Glimmer-30B
SELA_LLM_MODEL_REVISION=cec94fcfd6512f2cfe708138c32533b346ea4f69
SELA_LLM_CONCURRENCY=2
SELA_LLM_OP_TIMEOUT=6m
SELA_LLM_WARM_WINDOW=5m
SELA_LLM_COLD_START_ESTIMATE=4m
# meta_api only: minimal | low | medium | high | xhigh (Muse Spark rejects none)
SELA_LLM_REASONING_EFFORT=minimal
SELA_MAX_AI_OPS_PER_SESSION=8
# Meta Model API example (development/demo only; requires the database for
# the budget gate). Never commit a real key.
# SELA_LLM_MODE=meta_api
# SELA_LLM_BASE_URL=https://api.meta.ai/v1
# SELA_LLM_API_KEY=
# SELA_LLM_SERVED_MODEL=muse-spark-1.3
# SELA_LLM_MODEL_ID=muse-spark-1.3
# SELA_LLM_MODEL_REVISION=muse-spark-1.3
# Durable monthly AI spend gate (D12). 0 disables it; when enabled the
# reserve is the worst-case cost of one operation and requires the database.
SELA_AI_MONTHLY_BUDGET_USD=0
SELA_AI_RESERVE_USD=0.25

# --- Operator console (separate trust domain) ------------------------------
# base64 of exactly 32 bytes. Unset disables /api/admin/v1 entirely.
# Generate with: openssl rand -base64 32
SELA_ADMIN_MFA_KEY=

# --- Test doubles (development and test only) ------------------------------
# SELA_LLM_MODE=test_double requires SELA_ALLOW_TEST_DOUBLE=true and
# SELA_ENV=development or test. Staging and production refuse it.
SELA_ALLOW_TEST_DOUBLE=false

# --- Local Docker / testbench (local-only files, not published) ------------
# SELA_PORT=8080
